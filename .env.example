# Local Laragon
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:5000

# Database: local Laragon default
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_NAME=balingasag_shs
DB_USER=root
DB_PASS=
DB_SSL_CA=
DB_SSL_CA_CONTENT=
DB_SSL_VERIFY_SERVER_CERT=1

# TiDB Cloud example
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=bshs_ams
# DB_USER=your-tidb-prefix.root
# DB_PASS=your-tidb-password
# DB_SSL_CA=C:\tmp\isrgrootx1.pem
# DB_SSL_VERIFY_SERVER_CERT=1

# Session storage
# Use database for Wasmer/TiDB deployment. Use file for simple local-only development.
APP_SESSION_DRIVER=file
APP_SESSION_LIFETIME=86400
APP_SESSION_IDLE_TIMEOUT=86400

# Auth / bootstrap (MUST be changed before production deployment)
DEFAULT_NEW_USER_PASSWORD=change-this-before-production
FIRST_RUN_ADMIN_PASSWORD=change-this-before-production

# App secrets (MUST be changed; generate with: php -r "echo bin2hex(random_bytes(32));")
API_AUTH_SECRET=replace-with-a-long-random-secret
API_SYNC_SECRET=replace-with-a-different-long-random-secret

# Resend / password reset OTP email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="Balingasag SHS"

# PWA Web Push notifications
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

# SMTP fallback / optional mail transport
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Balingasag Senior High School

# Optional template overrides
SF2_TEMPLATE_PATH=
SF5_TEMPLATE_PATH=
ECR_TEMPLATE_PATH=

