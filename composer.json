{
    "name": "bshs-ams/ams",
    "description": "Balingasag Senior High School - Attendance and Academic Management System",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "phpoffice/phpspreadsheet": "^5.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "classmap": [
            "functions/",
            "config/"
        ],
        "files": [
            "config/constants.php",
            "functions/app-helpers.php"
        ]
    },
    "scripts": {
        "seed:admin": "php database/seed_admin.php",
        "serve": "php -S localhost:5000 -t . router.php",
        "lint": "phpcs --standard=phpcs.xml",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "platform-check": false
    }
}
