<?xml version="1.0"?>
<ruleset name="BSHS AMS Focused Checks">
    <description>PHP syntax checks across all runtime source directories.</description>
    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Internal.LineEndings.Mixed">
        <severity>0</severity>
    </rule>
    <file>admin</file>
    <file>api</file>
    <file>auth</file>
    <file>config</file>
    <file>database</file>
    <file>functions</file>
    <file>includes</file>
    <file>parent</file>
    <file>scripts</file>
    <file>site</file>
    <file>src</file>
    <file>student</file>
    <file>teacher</file>
    <file>index.php</file>
    <file>router.php</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
